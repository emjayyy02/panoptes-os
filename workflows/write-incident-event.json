        "jsCode": "// Return Duplicate Result — Panoptes M11.3\n\nconst event = $('Validate Event Payload').first().json;\n\nreturn [{\n  json: {\n    event_id: event.event_id,\n    incident_id: event.incident_id,\n\n    event_written: false,\n    duplicate: true,\n\n    result: 'EVENT_ALREADY_EXISTS'\n  }\n}];"
