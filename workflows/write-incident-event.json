    {
      "parameters": {
        "jsCode": "// Validate Event Payload — Panoptes M11.3\n\nconst input = $input.first().json;\n\nif (!input.event_id) {\n  throw new Error('Panoptes event missing event_id');\n}\n\nif (!input.incident_id) {\n  throw new Error('Panoptes event missing incident_id');\n}\n\nif (!input.event_type) {\n  throw new Error('Panoptes event missing event_type');\n}\n\nif (\n  typeof input.event_message !== 'string' ||\n  input.event_message.trim().length === 0\n) {\n  throw new Error('Panoptes event missing event_message');\n}\n\nreturn [{\n  json: {\n    event_id: String(input.event_id),\n    incident_id: String(input.incident_id),\n    event_type: String(input.event_type),\n\n    event_message: input.event_message,\n\n    old_status: input.old_status ?? null,\n    new_status: input.new_status ?? null,\n\n    tool_name: input.tool_name ?? null,\n    tool_result: input.tool_result ?? null\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
