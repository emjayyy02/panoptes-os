# Template only. Never copy real credentials into this tracked file.
NODE_ENV=production
# Public build-time Auth settings; use the same project as the server.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server runtime only. No secret/service-role key is needed by this application.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PANOPTES_OPERATOR_IDS=
PANOPTES_CONSOLE_ORIGIN=https://console.example.invalid
PANOPTES_N8N_ORIGIN=https://restricted-n8n.example.invalid
PANOPTES_APPROVAL_HEADER_NAME=
PANOPTES_APPROVAL_HEADER_VALUE=
PANOPTES_GATEWAY_HOST=127.0.0.1
PANOPTES_GATEWAY_PORT=3001
# Container host binding is 0.0.0.0; publish only to loopback during local checks.
# Browser API remains /api/panoptes. All production origins must use HTTPS.
