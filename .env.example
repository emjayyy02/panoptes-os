# Public browser Auth configuration. Publishable/legacy anon key only; never a privileged key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server configuration. The URL/key must refer to the same Auth project as the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PANOPTES_OPERATOR_IDS=
PANOPTES_CONSOLE_ORIGIN=http://127.0.0.1:5173
PANOPTES_N8N_ORIGIN=
PANOPTES_GATEWAY_HOST=127.0.0.1
PANOPTES_GATEWAY_PORT=3001
# Server-only Header Auth for the exact approval POST. Preserve the existing credential.
PANOPTES_APPROVAL_HEADER_NAME=
PANOPTES_APPROVAL_HEADER_VALUE=

# NODE_ENV=production requires HTTPS origins and disables the ngrok development header.
# Browser API path is always /api/panoptes. VITE_PANOPTES_API_BASE is no longer used.
