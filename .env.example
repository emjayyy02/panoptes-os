# Local development only. Copy to .env.local and set the upstream origin.
VITE_PANOPTES_API_BASE=/api/panoptes
PANOPTES_DEV_PROXY_TARGET=https://your-tunnel.ngrok-free.dev
# Server-only Header Auth for approval POSTs. Populate .env.local; never use VITE_*.
PANOPTES_APPROVAL_HEADER_NAME=
PANOPTES_APPROVAL_HEADER_VALUE=
